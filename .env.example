# ==========================================
# SHOPSENSE APPLICATION ENVIRONMENT CONFIG
# ==========================================

# Core Application Settings
PROJECT_NAME="ShopSense"
PROJECT_TAGLINE="AI-Powered Multi-Vendor E-Commerce Analytics Platform"
SECRET_KEY="shopsense-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default for zero-config local dev, or PostgreSQL)
DATABASE_URL="sqlite:///./shopsense.db"
# DATABASE_URL="postgresql://shopsense:shopsense_password@localhost:5432/shopsensedb"

# Optional Cloud Generative AI Keys (Application runs local deterministic fallback if empty)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Redis Cache / Background Tasks
REDIS_URL="redis://localhost:6379/0"

# Frontend Vite Configuration
VITE_API_URL="http://localhost:8000/api"
